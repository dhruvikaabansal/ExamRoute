# Copy to client/.env and fill in.
# Only VITE_API_URL is required — Google sign-in and Razorpay checkout are
# optional, and the app runs fully without them (the server falls back to
# email+password auth and mock payments).

VITE_API_URL=http://localhost:5000/api

# Optional — enables the "Sign in with Google" button.
# Must be the SAME client id configured as GOOGLE_CLIENT_ID on the server.
VITE_GOOGLE_CLIENT_ID=

# Optional — enables real Razorpay checkout instead of the mock payment flow.
# Must match RAZORPAY_KEY_ID on the server.
VITE_RAZORPAY_KEY_ID=
