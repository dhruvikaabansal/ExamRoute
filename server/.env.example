# Copy to server/.env and fill in.
#
# Only MONGO_URI and JWT_SECRET are REQUIRED — the server refuses to start
# without them. Everything else has a working fallback, so you can run and
# demo the entire app (auth, booking, payment, routing, QR boarding, live
# tracking) with just those two set.

# ---------------------------------------------------------------- server
PORT=5000
NODE_ENV=development
# Comma-separated allowlist of browser origins permitted to call this API.
CLIENT_URL=http://localhost:5173

# -------------------------------------------------------------- database
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/examroute

# ------------------------------------------------------------------ auth
# REQUIRED. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters when NODE_ENV=production.
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Optional — only needed for "Sign in with Google". Email+password works
# without it. Must match VITE_GOOGLE_CLIENT_ID in the client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# This email is promoted to admin automatically on signup/login, so you can
# open the Admin page and appoint conductors from there.
ADMIN_EMAIL=you@example.com

# -------------------------------------------------------------- payments
# Blank locally = DEV MOCK MODE: payment is simulated so the project runs with
# no Razorpay account at all.
#
# REQUIRED IN PRODUCTION. Simulated payments are refused outside development,
# with no override — an endpoint that marks a booking paid for free should not
# be one environment variable away from being live. A deployed API without
# these keys will boot, log an error, and fail at checkout.
#
# Test-mode keys are free, need no KYC, and exercise the real thing: real
# checkout, real order ids, real signatures. Razorpay dashboard -> Settings ->
# API Keys -> Generate Test Key. They start rzp_test_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ------------------------------------------------------------------ maps
# Blank = offline mock mode: straight-line distance estimates and
# nearest-neighbour stop ordering, so the whole flow works with no key.
GOOGLE_MAPS_API_KEY=

# ----------------------------------------------------------------- email
# Leave everything here blank for dev mode: OTPs and confirmations are printed
# to the server console instead of being sent, so signup works with zero setup.
#
# ON A DEPLOYED APP, PREFER RESEND OVER SMTP.
# Render, Fly, Railway and most other free tiers block outbound SMTP (ports 25,
# 465 and 587) as an anti-spam measure. Correct Gmail credentials will still
# produce "Connection timeout" on every send, forever, because the port is shut
# rather than the password being wrong. Resend goes over HTTPS, which nobody
# blocks. Free tier is 3,000 emails a month, 100 a day.
#
# ONE CATCH, AND IT MATTERS FOR A PUBLIC DEMO:
# the shared onboarding@resend.dev sender is a sandbox. It can only deliver to
# the address your Resend account was created with; anyone else gets a 403.
# To email real visitors you must verify a domain you own (Resend gives you the
# SPF/DKIM records) and set MAIL_FROM to an address on it.
#
# Without a domain the app degrades honestly rather than silently: delivery
# fails, /api/health reports it, and the sign-up screen tells the visitor to use
# Google sign-in instead of waiting for a code that cannot reach them.
RESEND_API_KEY=

# SMTP is still supported, and is used when RESEND_API_KEY is blank. Fine
# locally or on a host that permits outbound mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Must be a sender the transport will accept. onboarding@resend.dev works with
# no setup but only reaches your own account address — see the note above.
MAIL_FROM=ExamRoute <onboarding@resend.dev>

# ------------------------------------------------------ fare and routing
FARE_PER_KM=3          # rupees per km, per seat
BASE_FARE=100          # flat base, per seat
MAX_SUBSIDY_PCT=50       # subsidy caps here for the farthest students
SUBSIDY_BAND_KM=50       # every 50 km of distance earns another band of subsidy
SUBSIDY_PER_BAND_PCT=5   # +5% per band, so the 50% cap arrives at 500 km
                         # (at 25 km bands every real journey hit the cap and
                         #  the graduated policy behaved as a flat discount)
BUS_CAPACITY=40        # seats per bus (companions count toward this)
SAFETY_BUFFER_MIN=60   # never plan to arrive later than gate close minus this
BOARDING_BUFFER_MIN=10 # how early passengers are asked to be at their stop
GEOFENCE_RADIUS_KM=5   # catchment radius around each pickup stop

# ------------------------------------------------------ cancellation policy
# A seat cancelled at the last minute cannot be resold, so the refundable
# share falls as the exam approaches. Cancel earlier than FULL_REFUND_HOURS
# before gate close for 100%; between that and PARTIAL_REFUND_HOURS for
# PARTIAL_REFUND_PCT; inside PARTIAL_REFUND_HOURS, nothing is due.
FULL_REFUND_HOURS=72
PARTIAL_REFUND_HOURS=24
PARTIAL_REFUND_PCT=50

# ----------------------------------------------------------------- tests
# Optional. Point the integration suite at an existing MongoDB instead of
# letting it download a private one:
#   MONGO_TEST_URI=mongodb://127.0.0.1:27017
MONGO_TEST_URI=
